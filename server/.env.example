# ── Required ─────────────────────────────────────────────────────────────
# At least 32 random characters. Generate: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-secret

# ── Email delivery ───────────────────────────────────────────────────────
# gmail   = Gmail SMTP with a Google App Password (587/465)
# resend  = real email through Resend (recommended for production)
# webhook = POST to your own mail service
# console = development only; prints the 6-digit code to the server log
EMAIL_PROVIDER=gmail

# Gmail: requires 2-Step Verification + App Password, NOT your Google password.
# https://myaccount.google.com/apppasswords
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

# Optional. Defaults to "MYRQVIA <GMAIL_USER>" when Gmail is used.
EMAIL_FROM=MYRQVIA <your-account@gmail.com>

# Resend: verify your sending domain first.
RESEND_API_KEY=

# Webhook: receives {to,subject,text,html}; Authorization: Bearer token optional.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# ── Server ───────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
# Comma-separated origins if the frontend is NOT served by this server.
ALLOWED_ORIGINS=
# Set true only behind a trusted reverse proxy.
TRUST_PROXY=false
# JSON data file (single-process server). Use a volume in production.
DATA_FILE=./data/myrqvia-auth.json
SESSION_DAYS=30
